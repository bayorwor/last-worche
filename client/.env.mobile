# Used by `bun run build:mobile`. The mobile app has no Vite server to forward /api, so it needs the full address.
# localhost reaches this computer from the iOS simulator, and from Android after `adb reverse tcp:3000 tcp:3000`.
# For an iPhone, do not edit this file: set VITE_API_BASE_URL when building, as the README describes.
VITE_API_BASE_URL=http://localhost:3000/api
