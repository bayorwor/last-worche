PORT=3000

# Matches setup-database.sql. These credentials are for local development only.
DATABASE_URL=mysql://lastworche:lastworche@localhost:3306/lastworche

# Web addresses allowed to call this API. These two are the iOS and Android apps.
CORS_ORIGINS=capacitor://localhost,http://localhost

# Signs session tokens. For local development only: use a long random value on any shared server.
JWT_SECRET=local-demo-secret-not-for-production

# true = the sign-in screen lists the seeded test accounts. Use false on any shared server.
TEST_ACCOUNTS_ENABLED=true

# How many sign-in requests one network address may send per minute.
SIGN_IN_LIMIT_PER_MINUTE=30

# Who may send hours from their own time tracking, as supplierId:key pairs. Use long random keys on any shared server.
SUPPLIER_API_KEYS=supplier-1:demo-consultis-key,supplier-2:demo-nordlicht-key

# true = plain rules read the one-sentence booking, so no API key or network is needed.
AI_MOCK=true

# Only needed with AI_MOCK=false.
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# true = emails are not sent, only noted in the server log, so no mail server is needed. Sign-in codes then appear
# on the sign-in screen, which lets anyone sign in as anyone. Use false on any shared server.
MAIL_MOCK=true
MAIL_FROM=lastWorche <no-reply@lastworche.example>

# Only needed with MAIL_MOCK=false.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
